# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL connection URL with pgvector support
# Format: postgresql://user:password@host:port/database
# Example: postgresql://ooredoo_user:ooredoo_pass@localhost:5432/ai_benchmark
DATABASE_URL=postgresql://ooredoo_user:ooredoo_pass@localhost:5432/ai_benchmark

# ============================================================================
# LLM API KEYS
# ============================================================================

# OpenAI API Key (for ChatGPT models)
# Get it from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-xxx

# Anthropic API Key (for Claude models)
# Get it from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-xxx

# Google Gemini API Key (for Gemini models)
# Get it from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyxxx

# Groq API Key (for Llama and other open models)
# Get it from: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxx

# ============================================================================
# LOCAL LLM CONFIGURATION
# ============================================================================

# Ollama service URL (for local model inference)
# Default: http://localhost:11434
# Note: Ensure Ollama is running before starting the benchmark
OLLAMA_URL=http://localhost:11434

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Environment (development, staging, production)
ENVIRONMENT=development

# API Host and Port
API_HOST=0.0.0.0
API_PORT=8000

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable/disable specific LLM providers
ENABLE_OPENAI=true
ENABLE_ANTHROPIC=true
ENABLE_GEMINI=true
ENABLE_GROQ=true
ENABLE_OLLAMA=true

# ============================================================================
# BENCHMARK CONFIGURATION
# ============================================================================

# Maximum concurrent benchmark executions
MAX_CONCURRENT_EXECUTIONS=4

# Timeout for LLM calls in seconds
LLM_CALL_TIMEOUT=60

# Maximum retries for failed LLM calls
LLM_RETRY_ATTEMPTS=3

# ============================================================================
# EVALUATION CONFIGURATION
# ============================================================================

# Number of repeated judge evaluations for consistency (Ragas metrics)
# Higher values = more stable results but slower evaluation
JUDGE_REPETITIONS=2

# LLM judge model (used for Ragas evaluation)
# Recommendations: llama-3.1-8b-instant (fast, cheap) or llama-3.3-70b-versatile (better quality)
JUDGE_MODEL=llama-3.1-8b-instant

# ============================================================================
# DATABASE MIGRATION (for future use)
# ============================================================================

# Auto-run migrations on startup (true/false)
RUN_MIGRATIONS_ON_STARTUP=false

# ============================================================================
# SECURITY
# ============================================================================

# JWT Secret Key for API authentication (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
# This should be a strong random string
JWT_SECRET_KEY=your-secret-key-here-change-in-production

# API Rate limiting (requests per minute)
API_RATE_LIMIT=1000

# ============================================================================
# MONITORING & DEBUGGING
# ============================================================================

# Enable detailed SQL query logging
SQL_ECHO=false

# Enable request/response logging for API
API_LOG_REQUESTS=true

# ============================================================================
# NOTES
# ============================================================================
# 1. This is an example configuration. Copy to .env and fill in your actual values.
# 2. Never commit .env to version control.
# 3. For production, use a secrets management system (e.g., AWS Secrets Manager, Vault).
# 4. Ensure database is running before starting the application.
# 5. For local development with Ollama, install it from https://ollama.ai/
